<!-- Flashpop Notification Handler -->
<link rel="stylesheet" href="/css/includes/flashpop.css"/>
<script src="/js/flashpop.js"></script>

<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      if (window.flashpop) {
        window.flashpop.success("<%= success[0] %>", "Success");
      }
    });
  </script>
<% } %>

<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      if (window.flashpop) {
        window.flashpop.error("<%= error[0] %>", "Notice");
      }
    });
  </script>
<% } %>
