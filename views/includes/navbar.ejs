<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>MilkMate - Smart Dairy Ecosystem</title>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <!-- Global Design System Tokens -->
  <link rel="stylesheet" href="/css/style.css"/>
  <!-- Header Stylesheet -->
  <link rel="stylesheet" href="/css/includes/navbar.css"/>
  <!-- Flashpop Stylesheet & Runtime -->
  <link rel="stylesheet" href="/css/includes/flashpop.css"/>
  <script src="/js/flashpop.js"></script>
</head>
<body>

<header class="mm-navbar">
  <div class="mm-navbar-container">
    <!-- Brand Logo & Name -->
    <a href="<%= currUser ? 
      (currUser.type === 'dairy' ? '/dairy' : 
      currUser.type === 'milkman' ? '/milkman' : 
      currUser.type === 'customer' ? '/customerrs' : '/') 
      : '/' %>" class="mm-brand">
      <div class="mm-brand-logo-wrapper">
        <img src="/images/Logo.png" alt="MilkMate Icon" class="mm-brand-logo">
      </div>
      <div class="mm-brand-text">
        <span class="mm-brand-name">
          MILKMATE
        </span>
        <span class="mm-brand-sub">Smart Dairy Network</span>
      </div>
    </a>

    <!-- Hamburger Toggle for Mobile -->
    <button class="mm-nav-toggle" id="navToggle" aria-label="Toggle navigation" onclick="toggleNavbarMenu()">
      <i class="fa-solid fa-bars" id="navToggleIcon"></i>
    </button>

    <!-- Desktop Navigation Links -->
    <nav class="mm-nav-menu" id="navMenu">
      <% if (!currUser) { %>
        <a href="/" class="mm-nav-link"><i class="fa-solid fa-house"></i> Home</a>
        <a href="/product/all" class="mm-nav-link"><i class="fa-solid fa-store"></i> Products</a>
        <a href="/about" class="mm-nav-link"><i class="fa-solid fa-circle-info"></i> About</a>
        <a href="/contact" class="mm-nav-link"><i class="fa-solid fa-envelope"></i> Contact</a>
        <a href="/login" class="mm-btn-login"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
        <a href="/signup" class="mm-btn-register"><i class="fa-solid fa-user-plus"></i> Get Started</a>
      <% } else { %>
        <!-- Logged-in Links -->
        <a href="<%= currUser.type === 'dairy' ? '/dairy' : 
                     currUser.type === 'milkman' ? '/milkman' : 
                     currUser.type === 'customer' ? '/customerrs' : '/' %>" class="mm-nav-link">
          <i class="fa-solid fa-gauge-high"></i> Dashboard
        </a>

        <% if (currUser.type === 'customer') { %>
          <a href="/customerrs/details" class="mm-nav-link"><i class="fa-solid fa-receipt"></i> Passbook</a>
          <a href="/product/all" class="mm-nav-link"><i class="fa-solid fa-shop"></i> Store</a>
          <a href="/cart" class="mm-nav-cart-btn">
            <i class="fa-solid fa-cart-shopping"></i> Cart
            <% if (typeof cart !== 'undefined' && cart && cart.length > 0) { %>
              <span class="mm-nav-cart-badge"><%= cart.length %></span>
            <% } %>
          </a>
        <% } else { %>
          <a href="/product" class="mm-nav-link"><i class="fa-solid fa-box-open"></i> Products</a>
        <% } %>

        <a href="/about" class="mm-nav-link"><i class="fa-solid fa-circle-info"></i> About</a>
        <a href="/contact" class="mm-nav-link"><i class="fa-solid fa-envelope"></i> Contact</a>

        <!-- User Identity Chip -->
        <div class="mm-user-pill">
          <div class="mm-user-avatar">
            <%= (currUser.name || currUser.dname || currUser.type || 'U').charAt(0).toUpperCase() %>
          </div>
          <div class="mm-user-details">
            <span class="mm-user-name">
              <%= currUser.name || currUser.dname || 'User' %>
            </span>
            <span class="mm-user-role">
              <%= currUser.type %> #<%= currUser.code || currUser.dairyCode || currUser.milkmanCode || '' %>
            </span>
          </div>
        </div>

        <a href="/logout" class="mm-btn-logout" title="Sign Out">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
        </a>
      <% } %>
    </nav>
  </div>
</header>

<!-- Flashpop Automatic Trigger -->
<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      if (window.flashpop) {
        window.flashpop.success("<%= success[0] %>", "Success");
      }
    });
  </script>
<% } %>

<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      if (window.flashpop) {
        window.flashpop.error("<%= error[0] %>", "Notice");
      }
    });
  </script>
<% } %>

<script>
  function toggleNavbarMenu() {
    const navMenu = document.getElementById('navMenu');
    const icon = document.getElementById('navToggleIcon');
    if (navMenu.classList.contains('active')) {
      navMenu.classList.remove('active');
      icon.classList.remove('fa-xmark');
      icon.classList.add('fa-bars');
    } else {
      navMenu.classList.add('active');
      icon.classList.remove('fa-bars');
      icon.classList.add('fa-xmark');
    }
  }
</script>
