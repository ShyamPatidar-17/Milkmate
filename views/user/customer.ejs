<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/user/customer.css">

<div class="auth-form-wrapper">
  <div class="auth-form-card">
    <div class="auth-form-head">
      <span class="auth-form-badge"><i class="fa-solid fa-user-check"></i> Customer Passbook Portal</span>
      <h2>Customer Portal Activation</h2>
      <p>Activate your digital passbook account to view daily milk entries and pending bills.</p>
    </div>

    <div class="auth-info-banner">
      <i class="fa-solid fa-circle-info"></i>
      <div>
        <strong>Prerequisite Note:</strong> Please ensure your Dairy Center has registered your customer profile with your Customer Code and Dairy Code before activating.
      </div>
    </div>

    <form id="customerSignupForm" action="/signup/customer" method="POST" novalidate>
      <div class="form-grid-2">
        <!-- Customer Code -->
        <div class="mm-form-group">
          <label class="mm-label" for="code">Your Customer Code *</label>
          <input type="number" name="customerr[code]" id="code" class="mm-input" placeholder="e.g. 101" required>
          <small id="codeError" class="field-error"></small>
        </div>

        <!-- Associated Dairy Code -->
        <div class="mm-form-group">
          <label class="mm-label" for="codeD">Dairy Center Code *</label>
          <input type="number" name="customerr[codeD]" id="codeD" class="mm-input" placeholder="e.g. 101" required>
          <small id="codeDError" class="field-error"></small>
        </div>
      </div>

      <!-- Mobile Number -->
      <div class="mm-form-group">
        <label class="mm-label" for="contact">10-Digit Registered Mobile Number *</label>
        <input type="tel" name="customerr[contact]" id="contact" class="mm-input" placeholder="e.g. 9879638521" required pattern="[0-9]{10}" maxlength="10">
        <small id="contactError" class="field-error"></small>
      </div>

      <div class="form-grid-2">
        <!-- Password -->
        <div class="mm-form-group">
          <label class="mm-label" for="password">Create Password *</label>
          <input type="password" name="customerr[password]" id="password" class="mm-input" placeholder="Minimum 5 characters" required minlength="5">
          <small id="passwordError" class="field-error"></small>
        </div>

        <!-- Confirm Password -->
        <div class="mm-form-group">
          <label class="mm-label" for="confirmPassword">Confirm Password *</label>
          <input type="password" name="customerr[confirmPassword]" id="confirmPassword" class="mm-input" placeholder="Re-enter password" required minlength="5">
          <small id="confirmPasswordError" class="field-error"></small>
        </div>
      </div>

      <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg auth-submit-btn">
        <i class="fa-solid fa-check"></i> Activate Customer Account
      </button>
    </form>

    <div class="auth-footer-links">
      <span>Already activated? <a href="/login">Sign In Here</a></span>
      <a href="/signup"><i class="fa-solid fa-arrow-left"></i> Change Role</a>
    </div>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  document.getElementById("customerSignupForm").addEventListener("submit", function(e) {
    let isValid = true;
    const pwd = document.getElementById("password").value;
    const confirmPwd = document.getElementById("confirmPassword").value;
    const confirmError = document.getElementById("confirmPasswordError");

    confirmError.textContent = "";
    if (pwd !== confirmPwd) {
      confirmError.textContent = "Passwords do not match.";
      isValid = false;
    }

    if (!isValid) e.preventDefault();
  });
</script>
