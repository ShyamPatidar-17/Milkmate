<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/user/dairy.css">

<div class="auth-form-wrapper">
  <div class="auth-form-card">
    <div class="auth-form-head">
      <span class="auth-form-badge"><i class="fa-solid fa-building-wheat"></i> Dairy Center Portal</span>
      <h2>Dairy Owner Registration</h2>
      <p>Register your collection center to manage farmers, daily milk intake, and auto-settlements.</p>
    </div>

    <form id="dairySignupForm" action="/signup/dairy" method="POST" novalidate>
      <div class="form-grid-2">
        <!-- Dairy Code -->
        <div class="mm-form-group">
          <label class="mm-label" for="dairyCode">Unique Dairy Code *</label>
          <input type="number" name="dairy[dairyCode]" id="dairyCode" class="mm-input" placeholder="e.g. 101" required>
          <small id="codeError" class="field-error"></small>
        </div>

        <!-- Owner Full Name -->
        <div class="mm-form-group">
          <label class="mm-label" for="fullName">Owner Full Name *</label>
          <input type="text" name="dairy[fullName]" id="fullName" class="mm-input" placeholder="e.g. Rajesh Sharma" required>
          <small id="nameError" class="field-error"></small>
        </div>

        <!-- Dairy Name -->
        <div class="mm-form-group">
          <label class="mm-label" for="dairyName">Dairy / Center Name *</label>
          <input type="text" name="dairy[dairyName]" id="dairyName" class="mm-input" placeholder="e.g. Amrit Dhara Dairy" required>
          <small id="dairyNameError" class="field-error"></small>
        </div>

        <!-- Contact Phone -->
        <div class="mm-form-group">
          <label class="mm-label" for="contact">10-Digit Mobile Number *</label>
          <input type="tel" name="dairy[contact]" id="contact" class="mm-input" placeholder="e.g. 9879638521" required maxlength="10">
          <small id="contactError" class="field-error"></small>
        </div>
      </div>

      <!-- Email Address -->
      <div class="mm-form-group">
        <label class="mm-label" for="email">Official Email Address *</label>
        <input type="email" name="dairy[email]" id="email" class="mm-input" placeholder="e.g. contact@amritdairy.com" required>
        <small id="emailError" class="field-error"></small>
      </div>

      <!-- Dairy Address -->
      <div class="mm-form-group">
        <label class="mm-label" for="dairyAddress">Physical Dairy Address *</label>
        <input type="text" name="dairy[dairyAddress]" id="dairyAddress" class="mm-input" placeholder="e.g. Village Kanadia, Bypass Road, Indore, MP" required>
        <small id="addressError" class="field-error"></small>
      </div>

      <div class="form-grid-2">
        <!-- Password -->
        <div class="mm-form-group">
          <label class="mm-label" for="password">Create Password *</label>
          <input type="password" name="dairy[password]" id="password" class="mm-input" placeholder="Minimum 5 characters" required minlength="5">
          <small id="passwordError" class="field-error"></small>
        </div>

        <!-- Confirm Password -->
        <div class="mm-form-group">
          <label class="mm-label" for="confirmPassword">Confirm Password *</label>
          <input type="password" name="dairy[confirmPassword]" id="confirmPassword" class="mm-input" placeholder="Re-enter password" required minlength="5">
          <small id="confirmPasswordError" class="field-error"></small>
        </div>
      </div>

      <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg auth-submit-btn">
        <i class="fa-solid fa-check"></i> Complete Dairy Registration
      </button>
    </form>

    <div class="auth-footer-links">
      <span>Already have a dairy registered? <a href="/login">Sign In Here</a></span>
      <a href="/signup"><i class="fa-solid fa-arrow-left"></i> Change Role</a>
    </div>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  document.getElementById("dairySignupForm").addEventListener("submit", function(e) {
    let isValid = true;
    const pwd = document.getElementById("password").value;
    const confirmPwd = document.getElementById("confirmPassword").value;
    const confirmError = document.getElementById("confirmPasswordError");

    confirmError.textContent = "";
    if (pwd !== confirmPwd) {
      confirmError.textContent = "Passwords do not match.";
      isValid = false;
    }

    if (!isValid) e.preventDefault();
  });
</script>
