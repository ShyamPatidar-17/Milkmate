<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/milk/add.css">

<div class="milk-entry-wrapper">
  <div class="milk-entry-layout-grid">
    <!-- Left Column: Milk Delivery Form -->
    <div class="milk-entry-card">
      <div class="milk-entry-head">
        <span class="milk-entry-badge" style="background:#f0f9ff; color:#0284c7; border-color:#bae6fd;">
          <i class="fa-solid fa-truck-fast"></i> Milk Distribution Ledger
        </span>
        <h2>Record Milk Delivery</h2>
        <p>Log delivery with Fat & SNF automated rate pricing under Milkman #<%= user.milkmanCode %></p>
      </div>

      <form action="/milkman/sell" method="POST" id="milkSellForm">
        <!-- Hidden Milkman Code -->
        <input type="hidden" name="milk[milkmanCode]" value="<%= user.milkmanCode %>">

        <!-- Customer Code -->
        <div class="mm-form-group">
          <label class="mm-label" for="customerCode" style="display:flex; justify-content:space-between; align-items:center;">
            <span>Household Customer Code *</span>
            <small id="lookupBadge" style="font-size:0.75rem; color:#64748b; font-weight:600;">Type code for live preview</small>
          </label>
          <div style="position:relative;">
            <input type="number" id="customerCode" name="milk[code]" class="mm-input" placeholder="Enter customer code (e.g. 101, 1, 2...)" required min="1" autocomplete="off">
            <span id="inputStatusSpinner" style="position:absolute; right:14px; top:50%; transform:translateY(-50%); display:none; color:#0284c7;">
              <i class="fa-solid fa-spinner fa-spin"></i>
            </span>
          </div>
        </div>

        <!-- Automated Date & Shift Row (Read-Only / Unchangeable) -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom: 18px;">
          <div>
            <label class="mm-label">
              <i class="fa-solid fa-calendar-check" style="color:#0284c7;"></i> Date (Auto-Locked)
            </label>
            <div style="background:#f1f5f9; border:1.5px solid #cbd5e1; border-radius:12px; padding:11px 14px; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:8px;">
              <i class="fa-solid fa-lock" style="color:#64748b; font-size:0.85rem;"></i>
              <span id="displayDateText">Setting date...</span>
            </div>
            <!-- Hidden locked date value -->
            <input type="hidden" id="dateInput" name="milk[date]" value="">
          </div>

          <div>
            <label class="mm-label">
              <i class="fa-solid fa-clock" style="color:#0284c7;"></i> Shift (Auto-Locked)
            </label>
            <div id="shiftDisplayBox" style="background:#f1f5f9; border:1.5px solid #cbd5e1; border-radius:12px; padding:11px 14px; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:8px;">
              <i class="fa-solid fa-lock" style="color:#64748b; font-size:0.85rem;"></i>
              <span id="displayShiftText">Detecting shift...</span>
            </div>
            <!-- Hidden locked shift value -->
            <input type="hidden" id="shiftInput" name="milk[shift]" value="Mor">
          </div>
        </div>

        <!-- Quantity Liters -->
        <div class="mm-form-group">
          <label class="mm-label" for="liter">Milk Quantity (Liters) *</label>
          <input type="number" step="any" id="liter" name="milk[liter]" class="mm-input" placeholder="e.g. 2.0" required min="0.1">
        </div>

        <!-- Fat (%) & SNF (%) Grid -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
          <div class="mm-form-group">
            <label class="mm-label" for="fat">
              <i class="fa-solid fa-droplet" style="color:#f59e0b;"></i> Fat % (Testing) *
            </label>
            <input type="number" step="0.1" id="fat" name="milk[fat]" class="mm-input" placeholder="e.g. 6.5" value="6.5" required min="1.0" max="15.0">
            <small style="color:#64748b; font-size:0.78rem;">Standard: 3.5% &ndash; 9.0%</small>
          </div>

          <div class="mm-form-group">
            <label class="mm-label" for="snf">
              <i class="fa-solid fa-flask" style="color:#0284c7;"></i> SNF % (Solids-Not-Fat) *
            </label>
            <input type="number" step="0.1" id="snf" name="milk[snf]" class="mm-input" placeholder="e.g. 8.5" value="8.5" required min="4.0" max="15.0">
            <small style="color:#64748b; font-size:0.78rem;">Standard: 8.0% &ndash; 9.5%</small>
          </div>
        </div>

        <!-- Formula Notice & Live Calculation Box -->
        <div class="calc-preview-box" style="flex-direction:column; align-items:stretch; gap:10px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="font-size:0.85rem; color:#475569; font-weight:600;">
              <i class="fa-solid fa-calculator" style="color:#0284c7; margin-right:4px;"></i>
              Formula: (Fat &times; 6.5) + (SNF &times; 3.5)
            </span>
            <span style="font-size:0.95rem; font-weight:800; color:#0f172a;" id="ratePreview">
              Rate: ₹72.00 / Liter
            </span>
            <!-- Hidden auto-computed rate -->
            <input type="hidden" id="rateInput" name="milk[rate]" value="72.00">
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; padding-top:8px; border-top:1px dashed #cbd5e1;">
            <span class="calc-preview-label" style="font-size:1rem; font-weight:700; color:#0f172a;">
              Total Sale Amount:
            </span>
            <span class="calc-preview-value" id="calcPreview" style="color:#0284c7;">
              ₹0.00
            </span>
          </div>
        </div>

        <div class="milk-form-footer-actions">
          <button type="submit" class="mm-btn mm-btn-accent mm-btn-lg" style="width:100%;">
            <i class="fa-solid fa-check"></i> Save Milk Delivery Entry
          </button>
          <a href="/milkman" class="mm-btn mm-btn-secondary" style="width:100%; text-align:center;">
            <i class="fa-solid fa-arrow-left"></i> Cancel & Return to Dashboard
          </a>
        </div>
      </form>
    </div>

    <!-- Right Column: Live Customer Details Side View -->
    <aside class="farmer-side-card" id="farmerSideCard">
      <div class="farmer-side-head">
        <h3><i class="fa-solid fa-id-card-clip" style="color:#0284c7;"></i> Customer Side View</h3>
        <span class="farmer-side-status status-waiting" id="sideStatusBadge">Awaiting Code</span>
      </div>

      <!-- State 1: Awaiting Input / Empty -->
      <div id="sideEmptyState" class="side-view-empty">
        <div class="side-view-empty-icon" style="background:#f0f9ff; color:#0284c7;">
          <i class="fa-solid fa-house-chimney-user"></i>
        </div>
        <h4>Customer Details Preview</h4>
        <p>Enter the Customer Code on the left to immediately inspect delivery address, contact info, total milk received, and current balance.</p>
      </div>

      <!-- State 2: Loading Spinner -->
      <div id="sideLoadingState" class="side-view-loading" style="display:none; color:#0284c7;">
        <i class="fa-solid fa-circle-notch fa-spin"></i>
        <p>Looking up customer records...</p>
      </div>

      <!-- State 3: Customer Profile Found -->
      <div id="sideProfileState" style="display:none;">
        <div class="farmer-profile-main">
          <div class="farmer-avatar" id="sideAvatar" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">C</div>
          <div class="farmer-name-block">
            <h4 id="sideFarmerName">Customer Name</h4>
            <span class="mm-badge" id="sideFarmerCodeBadge" style="background:#e0f2fe; color:#0284c7; border:1px solid #bae6fd;">Customer #101</span>
          </div>
        </div>

        <div class="farmer-meta-list">
          <div class="farmer-meta-row">
            <i class="fa-solid fa-phone" style="color:#0284c7;"></i>
            <div>
              <span>Contact: </span>
              <strong><a href="#" id="sideFarmerPhone" class="phone-link" style="color:#0284c7; font-weight:700;">—</a></strong>
            </div>
          </div>
          <div class="farmer-meta-row">
            <i class="fa-solid fa-map-location-dot" style="color:#0284c7;"></i>
            <div>
              <span>Delivery Address: </span>
              <strong id="sideFarmerAddress">—</strong>
            </div>
          </div>
          <div class="farmer-meta-row">
            <i class="fa-solid fa-route" style="color:#0284c7;"></i>
            <div>
              <span>Route / Vendor: </span>
              <strong id="sideDairyAffiliation">Milkman #<%= user.milkmanCode %></strong>
            </div>
          </div>
        </div>

        <!-- Quick KPI Grid -->
        <div class="farmer-kpi-grid">
          <div class="side-kpi-card">
            <span>Total Milk Taken</span>
            <h4 id="sideTotalLiters" style="color:#0284c7;">0.0 L</h4>
          </div>
          <div class="side-kpi-card">
            <span>Pending Bill</span>
            <h4 id="sideTotalAmount" style="color:#b45309;">₹0.00</h4>
          </div>
        </div>

        <!-- Last Delivery Record Snapshot -->
        <div class="side-last-entry-box" id="sideLastEntryBox" style="background:#f0f9ff; border-color:#bae6fd;">
          <h5 style="color:#0369a1;"><i class="fa-solid fa-history"></i> Last Delivery</h5>
          <p id="sideLastEntryText">No past delivery records found.</p>
        </div>

        <!-- Direct Link to Customer Details -->
        <a href="#" id="sidePassbookLink" class="mm-btn mm-btn-secondary mm-btn-sm" style="width:100%; justify-content:center;" target="_blank">
          <i class="fa-solid fa-receipt"></i> Open Delivery Passbook
        </a>
      </div>

      <!-- State 4: Not Found Alert -->
      <div id="sideNotFoundState" class="side-view-empty" style="display:none;">
        <div class="side-view-empty-icon" style="background:#fef2f2; color:#ef4444;">
          <i class="fa-solid fa-user-xmark"></i>
        </div>
        <h4 style="color:#b91c1c;">Customer Not Found</h4>
        <p id="notFoundMsg">No route customer registered with this code under Milkman #<%= user.milkmanCode %>.</p>
        <a href="/milkman/add" class="mm-btn mm-btn-accent mm-btn-sm" style="margin-top:12px;">
          <i class="fa-solid fa-user-plus"></i> Enroll This Customer
        </a>
      </div>
    </aside>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    // 1. Automatic Date setting (Cannot be modified)
    const now = new Date();
    const yyyy = now.getFullYear();
    const mm = String(now.getMonth() + 1).padStart(2, '0');
    const dd = String(now.getDate()).padStart(2, '0');
    const isoDate = `${yyyy}-${mm}-${dd}`;

    document.getElementById('dateInput').value = isoDate;
    document.getElementById('displayDateText').textContent = now.toLocaleDateString('en-IN', {
      weekday: 'short',
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });

    // 2. Automatic Shift setting (Cannot be modified)
    const hours = now.getHours();
    const isMorning = (hours >= 3 && hours < 13);
    const shiftCode = isMorning ? 'Mor' : 'Eve';
    const shiftLabel = isMorning ? '🌅 Morning Shift' : '🌙 Evening Shift';

    document.getElementById('shiftInput').value = shiftCode;
    const shiftText = document.getElementById('displayShiftText');
    const shiftBox = document.getElementById('shiftDisplayBox');
    shiftText.textContent = shiftLabel;
    if (isMorning) {
      shiftBox.style.background = '#fef3c7';
      shiftBox.style.borderColor = '#fde68a';
      shiftBox.style.color = '#b45309';
    } else {
      shiftBox.style.background = '#e0e7ff';
      shiftBox.style.borderColor = '#c7d2fe';
      shiftBox.style.color = '#4338ca';
    }

    // 3. Real-time Fat & SNF Rate Calculation
    const fatInput = document.getElementById('fat');
    const snfInput = document.getElementById('snf');
    const literInput = document.getElementById('liter');
    const ratePreview = document.getElementById('ratePreview');
    const rateInput = document.getElementById('rateInput');
    const calcPreview = document.getElementById('calcPreview');

    function calculatePricing() {
      const fat = parseFloat(fatInput.value) || 0;
      const snf = parseFloat(snfInput.value) || 0;
      const liters = parseFloat(literInput.value) || 0;

      const calculatedRate = (fat * 6.5) + (snf * 3.5);
      const totalAmount = calculatedRate * liters;

      ratePreview.textContent = `Rate: ₹${calculatedRate.toFixed(2)} / Liter`;
      rateInput.value = calculatedRate.toFixed(2);
      calcPreview.textContent = `₹${totalAmount.toFixed(2)}`;
    }

    fatInput.addEventListener('input', calculatePricing);
    snfInput.addEventListener('input', calculatePricing);
    literInput.addEventListener('input', calculatePricing);

    calculatePricing();

    // 4. Live Customer Code Lookup for Side View
    const codeInput = document.getElementById('customerCode');
    const sideEmptyState = document.getElementById('sideEmptyState');
    const sideLoadingState = document.getElementById('sideLoadingState');
    const sideProfileState = document.getElementById('sideProfileState');
    const sideNotFoundState = document.getElementById('sideNotFoundState');
    const sideStatusBadge = document.getElementById('sideStatusBadge');
    const inputStatusSpinner = document.getElementById('inputStatusSpinner');
    const lookupBadge = document.getElementById('lookupBadge');

    let debounceTimer = null;

    function resetSideView() {
      sideEmptyState.style.display = 'block';
      sideLoadingState.style.display = 'none';
      sideProfileState.style.display = 'none';
      sideNotFoundState.style.display = 'none';
      sideStatusBadge.className = 'farmer-side-status status-waiting';
      sideStatusBadge.textContent = 'Awaiting Code';
      inputStatusSpinner.style.display = 'none';
      lookupBadge.textContent = 'Type code for live preview';
      lookupBadge.style.color = '#64748b';
    }

    codeInput.addEventListener('input', () => {
      const codeVal = codeInput.value.trim();
      clearTimeout(debounceTimer);

      if (!codeVal) {
        resetSideView();
        return;
      }

      sideEmptyState.style.display = 'none';
      sideProfileState.style.display = 'none';
      sideNotFoundState.style.display = 'none';
      sideLoadingState.style.display = 'block';
      inputStatusSpinner.style.display = 'block';
      lookupBadge.textContent = 'Checking database...';
      lookupBadge.style.color = '#0284c7';

      debounceTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/milkman/api/customer/${encodeURIComponent(codeVal)}`);
          const data = await res.json();
          inputStatusSpinner.style.display = 'none';
          sideLoadingState.style.display = 'none';

          if (data.success && data.found && data.customer) {
            const cust = data.customer;
            // Render profile
            document.getElementById('sideAvatar').textContent = (cust.first ? cust.first.charAt(0) : 'C').toUpperCase();
            document.getElementById('sideFarmerName').textContent = cust.name || `${cust.first} ${cust.last}`;
            document.getElementById('sideFarmerCodeBadge').textContent = `Customer #${cust.code}`;
            
            const phoneEl = document.getElementById('sideFarmerPhone');
            phoneEl.textContent = `+91 ${cust.contact}`;
            phoneEl.href = `tel:${cust.contact}`;

            document.getElementById('sideFarmerAddress').textContent = cust.address || 'Household Delivery Address';
            document.getElementById('sideTotalLiters').textContent = `${cust.totalLiters.toFixed(1)} L`;
            document.getElementById('sideTotalAmount').textContent = `₹${cust.totalAmount.toFixed(2)}`;

            const lastEntryEl = document.getElementById('sideLastEntryText');
            if (cust.lastEntry) {
              const d = new Date(cust.lastEntry.date);
              const formattedDate = d.toLocaleDateString('en-IN', { day:'2-digit', month:'short' });
              const shift = (cust.lastEntry.shift === 'Mor') ? 'Morning' : 'Evening';
              lastEntryEl.innerHTML = `<strong>${formattedDate} (${shift})</strong>: ${cust.lastEntry.liter}L @ ₹${cust.lastEntry.rate} (₹${cust.lastEntry.amount || (cust.lastEntry.liter * cust.lastEntry.rate).toFixed(2)})`;
            } else {
              lastEntryEl.textContent = 'No previous deliveries recorded.';
            }

            document.getElementById('sidePassbookLink').href = `/milkman/${cust.id}`;

            sideStatusBadge.className = 'farmer-side-status status-verified';
            sideStatusBadge.innerHTML = '<i class="fa-solid fa-circle-check"></i> Enrolled';
            lookupBadge.textContent = `✓ ${cust.name}`;
            lookupBadge.style.color = '#0284c7';

            sideProfileState.style.display = 'block';
          } else {
            // Not found
            sideNotFoundState.style.display = 'block';
            document.getElementById('notFoundMsg').textContent = `No customer registered with Code #${codeVal} under Milkman #<%= user.milkmanCode %>.`;
            sideStatusBadge.className = 'farmer-side-status status-notfound';
            sideStatusBadge.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Not Found';
            lookupBadge.textContent = `✗ Not found (#${codeVal})`;
            lookupBadge.style.color = '#ef4444';
          }
        } catch (err) {
          console.error('Customer lookup error:', err);
          inputStatusSpinner.style.display = 'none';
          sideLoadingState.style.display = 'none';
          sideNotFoundState.style.display = 'block';
          document.getElementById('notFoundMsg').textContent = 'Error connecting to database. Please try again.';
        }
      }, 300);
    });
  });
</script>
