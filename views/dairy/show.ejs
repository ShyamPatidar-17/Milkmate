<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/dairy/index.css">
<link rel="stylesheet" href="/css/dairy/showCustomer.css">

<div class="passbook-container">
  <!-- Navigation Toolbar -->
  <div class="passbook-nav-bar">
    <div class="passbook-title-group">
      <h2><i class="fa-solid fa-receipt" style="color:#059669;"></i> Farmer Passbook & Milk Ledger</h2>
      <p>Customer Code #<%= customer.code %> &bull; Registered at Dairy #<%= customer.codeD %></p>
    </div>

    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <button onclick="window.print()" class="mm-btn mm-btn-secondary mm-btn-sm">
        <i class="fa-solid fa-print"></i> Print Statement
      </button>
      <a href="/customers/<%= customer._id %>/edit" class="mm-btn mm-btn-secondary mm-btn-sm">
        <i class="fa-solid fa-pen-to-square"></i> Edit Profile
      </a>
      <a href="/customers/allcustomers" class="mm-btn mm-btn-secondary mm-btn-sm">
        <i class="fa-solid fa-arrow-left"></i> Customer List
      </a>
    </div>
  </div>

  <!-- Profile Overview Card -->
  <div class="profile-overview-card">
    <div class="profile-main-meta">
      <div class="profile-avatar-large">
        <%= (customer.first ? customer.first.charAt(0) : 'C').toUpperCase() %>
      </div>
      <div>
        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:4px;">
          <h3 style="font-size:1.35rem; font-weight:800; color:#0f172a; margin:0;"><%= customer.first %> <%= customer.last %></h3>
          <span class="code-badge">Customer #<%= customer.code %></span>
        </div>
        
        <!-- Live Settlement Status Badge on Customer Profile -->
        <% if (netPending === 0 && totalGross > 0) { %>
          <span style="display:inline-flex; align-items:center; gap:6px; background:#ecfdf5; color:#059669; border:1.5px solid #a7f3d0; padding:4px 12px; border-radius:9999px; font-size:0.82rem; font-weight:800;">
            <i class="fa-solid fa-circle-check"></i> Account Cleared (Zero Dues)
          </span>
        <% } else if (totalSettled > 0 && netPending > 0) { %>
          <span style="display:inline-flex; align-items:center; gap:6px; background:#fffbeb; color:#d97706; border:1.5px solid #fde68a; padding:4px 12px; border-radius:9999px; font-size:0.82rem; font-weight:800;">
            <i class="fa-solid fa-clock-rotate-left"></i> Partially Settled &bull; ₹<%= netPending.toFixed(2) %> Pending
          </span>
        <% } else if (totalSettled === 0 && netPending > 0) { %>
          <span style="display:inline-flex; align-items:center; gap:6px; background:#fef2f2; color:#ef4444; border:1.5px solid #fca5a5; padding:4px 12px; border-radius:9999px; font-size:0.82rem; font-weight:800;">
            <i class="fa-solid fa-circle-exclamation"></i> Payment Pending &bull; ₹<%= netPending.toFixed(2) %> Due
          </span>
        <% } else { %>
          <span style="display:inline-flex; align-items:center; gap:6px; background:#f1f5f9; color:#64748b; border:1.5px solid #cbd5e1; padding:4px 12px; border-radius:9999px; font-size:0.82rem; font-weight:700;">
            <i class="fa-solid fa-minus"></i> No Recorded Dues
          </span>
        <% } %>
      </div>
    </div>

    <div class="profile-details-list">
      <div class="meta-field">
        <span class="meta-field-label">Dairy Affiliation</span>
        <span class="meta-field-value">#<%= customer.codeD %></span>
      </div>
      <div class="meta-field">
        <span class="meta-field-label">Mobile Contact</span>
        <span class="meta-field-value">
          <a href="tel:<%= customer.contact %>" class="phone-link">+91 <%= customer.contact %></a>
        </span>
      </div>
      <div class="meta-field">
        <span class="meta-field-label">Delivery Address</span>
        <span class="meta-field-value"><%= customer.address || '—' %></span>
      </div>
      <div class="meta-field">
        <span class="meta-field-label">Total Delivery Logs</span>
        <span class="meta-field-value"><%= milk ? milk.length : 0 %> entries</span>
      </div>
    </div>

    <div class="profile-actions-group">
      <form method="POST" action="/customers/<%= customer._id %>?_method=delete" onsubmit="return confirm('Are you sure you want to delete this customer? All milk records will remain in ledger.');">
        <button type="submit" class="mm-btn mm-btn-danger mm-btn-sm">
          <i class="fa-solid fa-trash"></i> Delete Customer
        </button>
      </form>
    </div>
  </div>

  <!-- KPI Summary Cards: Gross, Settled, and Net Outstanding Balance -->
  <% 
    let calcTotalLiters = 0;
    if (milk && milk.length > 0) {
      for (const entry of milk) {
        calcTotalLiters += (Number(entry.liter) || 0);
      }
    }
  %>

  <div class="kpi-metrics-row" style="grid-template-columns: repeat(4, 1fr);">
    <!-- KPI 1: Liters -->
    <div class="kpi-card">
      <div class="kpi-icon" style="background:#ecfdf5; color:#059669;">
        <i class="fa-solid fa-bottle-droplet"></i>
      </div>
      <div class="kpi-text">
        <h3><%= calcTotalLiters.toFixed(1) %> L</h3>
        <p>Total Milk Delivered</p>
      </div>
    </div>

    <!-- KPI 2: Gross Lifetime Value -->
    <div class="kpi-card">
      <div class="kpi-icon" style="background:#f0f9ff; color:#0284c7;">
        <i class="fa-solid fa-calculator"></i>
      </div>
      <div class="kpi-text">
        <h3>₹<%= totalGross.toFixed(2) %></h3>
        <p>Gross Value of Milk</p>
      </div>
    </div>

    <!-- KPI 3: Already Settled / Paid -->
    <div class="kpi-card">
      <div class="kpi-icon" style="background:#f5f3ff; color:#7c3aed;">
        <i class="fa-solid fa-hand-holding-dollar"></i>
      </div>
      <div class="kpi-text">
        <h3>₹<%= totalSettled.toFixed(2) %></h3>
        <p>Total Amount Paid Out</p>
      </div>
    </div>

    <!-- KPI 4: Net Balance Due -->
    <div class="kpi-card" style="<%= netPending > 0 ? 'border:1.5px solid #fca5a5;' : 'border:1.5px solid #86efac;' %>">
      <div class="kpi-icon" style="<%= netPending > 0 ? 'background:#fef2f2; color:#dc2626;' : 'background:#ecfdf5; color:#059669;' %>">
        <i class="fa-solid <%= netPending > 0 ? 'fa-hourglass-half' : 'fa-circle-check' %>"></i>
      </div>
      <div class="kpi-text">
        <h3 style="<%= netPending > 0 ? 'color:#dc2626;' : 'color:#059669;' %>">
          ₹<%= netPending.toFixed(2) %>
        </h3>
        <p><%= netPending > 0 ? 'Net Outstanding Balance' : 'Account Fully Cleared' %></p>
      </div>
    </div>
  </div>

  <!-- Section 1: Chronological Daily Milk Intake Table -->
  <div class="data-card" style="margin-top:28px;">
    <div class="table-header-stripe">
      <h3><i class="fa-solid fa-clipboard-list" style="color:#059669; margin-right:8px;"></i> Milk Intake History</h3>
      <span style="font-size:0.85rem; font-weight:600; color:#64748b;"><%= milk ? milk.length : 0 %> Deliveries</span>
    </div>

    <div class="table-responsive">
      <% if (!milk || milk.length === 0) { %>
        <div class="empty-table-state">
          <div class="empty-icon"><i class="fa-solid fa-bottle-droplet"></i></div>
          <h3>No Intake Records Found</h3>
          <p>No milk collections have been logged for Farmer #<%= customer.code %> yet.</p>
          <a href="/dairy/add" class="mm-btn mm-btn-primary">
            <i class="fa-solid fa-plus"></i> Record First Milk Intake
          </a>
        </div>
      <% } else { %>
        <table class="modern-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Shift</th>
              <th>Fat (%)</th>
              <th>SNF (%)</th>
              <th>Quantity (L)</th>
              <th>Rate (₹ / L)</th>
              <th>Subtotal</th>
              <th style="text-align: right;">Payment Status</th>
            </tr>
          </thead>
          <tbody>
            <% 
              for (const entry of milk) { 
                const entryDate = entry.date ? new Date(entry.date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) : '—';
                const fatVal = entry.fat !== undefined ? entry.fat + '%' : '—';
                const snfVal = entry.snf !== undefined ? entry.snf + '%' : '—';
                const isPaid = entry.isPaymentCompleted;
            %>
              <tr class="<%= isPaid ? 'record-paid' : 'record-unpaid' %>" style="<%= isPaid ? 'background-color: #ecfdf5 !important;' : '' %>">
                <td><strong><%= entryDate %></strong></td>
                <td>
                  <% if (entry.shift === 'Mor' || entry.shift === 'Morning') { %>
                    <span class="shift-badge shift-mor"><i class="fa-solid fa-sun"></i> Morning</span>
                  <% } else { %>
                    <span class="shift-badge shift-eve"><i class="fa-solid fa-moon"></i> Evening</span>
                  <% } %>
                </td>
                <td><strong style="color:#f59e0b;"><%= fatVal %></strong></td>
                <td><strong style="color:#0284c7;"><%= snfVal %></strong></td>
                <td><strong><%= entry.liter %> L</strong></td>
                <td>₹<%= entry.rate %></td>
                <td><strong>₹<%= (entry.amount || (entry.liter * entry.rate)).toFixed(2) %></strong></td>
                <td style="text-align: right;">
                  <% if (isPaid) { %>
                    <span class="payment-badge payment-paid"><i class="fa-solid fa-circle-check"></i> Paid</span>
                  <% } else { %>
                    <span class="payment-badge payment-pending"><i class="fa-solid fa-clock"></i> Pending</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <!-- Section 2: Settlement Control Panel (Complete or Partial Settlement Option) -->
  <% if (netPending > 0) { %>
    <div class="settlement-card">
      <div style="margin-bottom:20px;">
        <span class="mm-badge mm-badge-primary" style="margin-bottom:8px;">
          <i class="fa-solid fa-hand-holding-dollar"></i> Account Settlement & Clearance
        </span>
        <h3 style="font-size:1.45rem; font-weight:800; color:#0f172a; margin-bottom:4px;">
          Process Payment for Customer #<%= customer.code %> (<%= customer.first %> <%= customer.last %>)
        </h3>
        <p style="color:#64748b; font-size:0.92rem; margin:0;">
          Select whether to settle the entire balance or process a custom partial installment payment.
        </p>
      </div>

      <form action="/dairy/pay" method="POST" id="settlementForm">
        <input type="hidden" name="pay[code]" value="<%= customer.code %>">
        <input type="hidden" name="pay[customerId]" value="<%= customer._id %>">

        <div class="settlement-panel-grid">
          <!-- Left Column: Controls & Amount Input -->
          <div>
            <!-- Option Switcher: Complete vs. Partial -->
            <label class="mm-label">Choose Settlement Option *</label>
            <div class="settlement-type-switcher">
              <button type="button" class="settle-switch-btn active" id="btnSettleFull" onclick="setSettlementMode('full')">
                <i class="fa-solid fa-circle-check"></i> Complete Settlement (100%)
              </button>
              <button type="button" class="settle-switch-btn" id="btnSettlePartial" onclick="setSettlementMode('partial')">
                <i class="fa-solid fa-pen-to-square"></i> Partial Settlement
              </button>
            </div>
            <input type="hidden" id="settlementOptionInput" name="pay[settlementOption]" value="full">

            <!-- Amount Input -->
            <div class="mm-form-group">
              <label class="mm-label" for="settleAmount">
                Payment / Settlement Amount (₹) *
              </label>
              <div style="position:relative;">
                <span style="position:absolute; left:14px; top:50%; transform:translateY(-50%); font-weight:800; color:#059669; font-size:1.1rem;">₹</span>
                <input type="number" step="0.01" id="settleAmount" name="pay[amount]" class="mm-input" style="padding-left:36px; font-size:1.15rem; font-weight:800;" value="<%= netPending.toFixed(2) %>" min="1" max="<%= netPending.toFixed(2) %>" required readonly>
              </div>
              <small id="amountHelpText" style="color:#64748b; font-size:0.8rem; margin-top:4px; display:block;">
                Full amount pre-filled. Switch to Partial Settlement to edit.
              </small>
            </div>

            <!-- Payment Mode & Notes in 2 columns -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
              <div class="mm-form-group">
                <label class="mm-label" for="paymentMode">Payment Mode *</label>
                <select name="pay[mode]" id="paymentMode" class="mm-input" style="font-weight:600;">
                  <option value="Cash">💵 Cash</option>
                  <option value="UPI / Online">📱 UPI (PhonePe / GPay)</option>
                  <option value="Bank Transfer">🏦 Direct Bank Transfer</option>
                  <option value="Cheque">📜 Cheque</option>
                </select>
              </div>

              <div class="mm-form-group">
                <label class="mm-label" for="settleNotes">Payment Note / Reference</label>
                <input type="text" name="pay[notes]" id="settleNotes" class="mm-input" placeholder="e.g. Cleared 1st week Oct">
              </div>
            </div>
          </div>

          <!-- Right Column: Real-time Live Receipt Calculation Card -->
          <div>
            <label class="mm-label">Settlement Summary Preview</label>
            <div class="settle-preview-receipt">
              <div class="settle-preview-row">
                <span>Total Gross Deliveries Accrued:</span>
                <strong>₹<%= totalGross.toFixed(2) %></strong>
              </div>
              <div class="settle-preview-row">
                <span>Previously Settled / Paid:</span>
                <strong style="color:#7c3aed;">-₹<%= totalSettled.toFixed(2) %></strong>
              </div>
              <div class="settle-preview-row" style="border-top:1px dashed #cbd5e1; padding-top:8px;">
                <span>Current Pending Due Balance:</span>
                <strong style="color:#dc2626;" id="previewCurrentDue">₹<%= netPending.toFixed(2) %></strong>
              </div>
              <div class="settle-preview-row">
                <span>Amount to Settle Now:</span>
                <strong style="color:#059669;" id="previewSettleNow">₹<%= netPending.toFixed(2) %></strong>
              </div>
              <div class="settle-preview-row settle-preview-total">
                <span>Remaining Dues After Payment:</span>
                <span id="previewRemainingDue">₹0.00</span>
              </div>
            </div>

            <!-- Submit Action Button -->
            <div style="margin-top:20px;">
              <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg" style="width:100%; justify-content:center;" id="btnSubmitSettlement">
                <i class="fa-solid fa-circle-check"></i> Settle Complete Amount (₹<%= netPending.toFixed(2) %>)
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>
  <% } else if (totalGross > 0) { %>
    <!-- Account 100% Cleared Celebration State -->
    <div class="settlement-card-cleared">
      <div style="max-width:620px; margin:0 auto;">
        <i class="fa-solid fa-circle-check" style="font-size:3rem; color:#059669; margin-bottom:12px; display:inline-block;"></i>
        <h3 style="font-size:1.6rem; font-weight:800; color:#065f46; margin-bottom:6px;">
          Account 100% Settled & Cleared!
        </h3>
        <p style="color:#475569; font-size:0.95rem; line-height:1.6; margin-bottom:16px;">
          There are zero outstanding dues for Farmer #<%= customer.code %> (<%= customer.first %> <%= customer.last %>). All past milk supplies valued at <strong>₹<%= totalGross.toFixed(2) %></strong> have been paid out in full across <strong><%= settlements.length %></strong> settlements.
        </p>
        <span class="mm-badge" style="background:#ffffff; color:#059669; border:1px solid #a7f3d0; font-size:0.85rem; padding:6px 14px;">
          <i class="fa-solid fa-shield-check"></i> Clean Ledger Record
        </span>
      </div>
    </div>
  <% } %>

  <!-- Section 3: Settlement & Clearance Audit Ledger -->
  <div class="settlement-history-card">
    <div class="table-header-stripe">
      <h3>
        <i class="fa-solid fa-clock-rotate-left" style="color:#7c3aed; margin-right:8px;"></i>
        Settlement & Clearance Audit History
      </h3>
      <span style="font-size:0.85rem; font-weight:600; color:#64748b;"><%= settlements ? settlements.length : 0 %> Settlement Records</span>
    </div>

    <div class="table-responsive">
      <% if (!settlements || settlements.length === 0) { %>
        <div class="empty-table-state" style="padding:40px 20px;">
          <div class="empty-icon" style="color:#94a3b8;"><i class="fa-solid fa-receipt"></i></div>
          <h4 style="font-size:1.1rem; color:#0f172a; margin-bottom:4px;">No Settlement Records Yet</h4>
          <p style="color:#64748b; font-size:0.88rem;">No payment transactions have been logged for this farmer account yet.</p>
        </div>
      <% } else { %>
        <table class="modern-table">
          <thead>
            <tr>
              <th>Settlement Date & Time</th>
              <th>Settlement Type</th>
              <th>Amount Settled</th>
              <th>Remaining Dues</th>
              <th>Payment Mode</th>
              <th>Notes / Remarks</th>
              <th style="text-align: right;">Processed By</th>
            </tr>
          </thead>
          <tbody>
            <% for (const s of settlements) { 
                const sDate = s.date ? new Date(s.date).toLocaleString('en-IN', {
                  day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
                }) : '—';
                const isFull = s.type === 'Full' || (s.remainingBalance === 0);
            %>
              <tr>
                <td><strong><%= sDate %></strong></td>
                <td>
                  <% if (isFull) { %>
                    <span class="badge-full-settle"><i class="fa-solid fa-circle-check"></i> Complete Settlement</span>
                  <% } else { %>
                    <span class="badge-partial-settle"><i class="fa-solid fa-clock-rotate-left"></i> Partial Payment</span>
                  <% } %>
                </td>
                <td><strong style="color:#059669; font-size:1.05rem;">₹<%= (Number(s.settledAmount) || 0).toFixed(2) %></strong></td>
                <td>
                  <% if (Number(s.remainingBalance) === 0) { %>
                    <span style="color:#059669; font-weight:700;">₹0.00 (Cleared)</span>
                  <% } else { %>
                    <span style="color:#d97706; font-weight:700;">₹<%= (Number(s.remainingBalance) || 0).toFixed(2) %></span>
                  <% } %>
                </td>
                <td><strong><%= s.paymentMode || 'Cash' %></strong></td>
                <td style="color:#475569;"><%= s.notes || '—' %></td>
                <td style="text-align: right; color:#64748b; font-weight:600;"><%= s.settledBy || 'Dairy Center' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  const netPendingMax = <%= netPending %>;
  const amountInput = document.getElementById('settleAmount');
  const optionInput = document.getElementById('settlementOptionInput');
  const btnFull = document.getElementById('btnSettleFull');
  const btnPartial = document.getElementById('btnSettlePartial');
  const helpText = document.getElementById('amountHelpText');
  const previewSettleNow = document.getElementById('previewSettleNow');
  const previewRemaining = document.getElementById('previewRemainingDue');
  const btnSubmit = document.getElementById('btnSubmitSettlement');

  function updateReceiptPreview(enteredAmount) {
    const validAmount = Math.min(Math.max(0, enteredAmount), netPendingMax);
    const remaining = Math.max(0, netPendingMax - validAmount);

    if (previewSettleNow) previewSettleNow.textContent = `₹${validAmount.toFixed(2)}`;
    if (previewRemaining) {
      previewRemaining.textContent = `₹${remaining.toFixed(2)}`;
      previewRemaining.style.color = (remaining === 0) ? '#059669' : '#d97706';
    }

    if (btnSubmit) {
      if (validAmount === netPendingMax) {
        btnSubmit.innerHTML = `<i class="fa-solid fa-circle-check"></i> Settle Complete Amount (₹${validAmount.toFixed(2)})`;
      } else {
        btnSubmit.innerHTML = `<i class="fa-solid fa-hand-holding-dollar"></i> Settle Partial Amount (₹${validAmount.toFixed(2)})`;
      }
    }
  }

  function setSettlementMode(mode) {
    if (!amountInput) return;

    if (mode === 'full') {
      btnFull.classList.add('active');
      btnPartial.classList.remove('active');
      optionInput.value = 'full';
      amountInput.value = netPendingMax.toFixed(2);
      amountInput.readOnly = true;
      helpText.textContent = 'Full balance pre-filled. Switch to Partial Settlement to edit.';
      helpText.style.color = '#64748b';
      updateReceiptPreview(netPendingMax);
    } else {
      btnPartial.classList.add('active');
      btnFull.classList.remove('active');
      optionInput.value = 'partial';
      amountInput.readOnly = false;
      amountInput.focus();
      helpText.textContent = `Enter custom partial amount (₹1.00 to ₹${netPendingMax.toFixed(2)})`;
      helpText.style.color = '#0284c7';
      updateReceiptPreview(parseFloat(amountInput.value) || 0);
    }
  }

  if (amountInput) {
    amountInput.addEventListener('input', () => {
      let val = parseFloat(amountInput.value) || 0;
      if (val > netPendingMax) {
        amountInput.value = netPendingMax.toFixed(2);
        val = netPendingMax;
      }
      updateReceiptPreview(val);
    });
  }
</script>
