<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/dairy/addcustomer.css">

<div class="add-cust-wrapper">
  <div class="add-cust-card">
    <div class="add-cust-head">
      <span class="add-cust-badge"><i class="fa-solid fa-building-wheat"></i> Dairy Ledger Enrollment</span>
      <h2>Register New Customer</h2>
      <p>Enroll a farmer or supplier under Dairy #<%= user.dairyCode %></p>
    </div>

    <form action="/customers" method="POST" id="addCustomerForm">
      <!-- Hidden Dairy Code -->
      <input type="hidden" name="customer[codeD]" value="<%= user.dairyCode %>">

      <!-- Customer Code -->
      <div class="mm-form-group">
        <label class="mm-label" for="code">Customer Code *</label>
        <input type="number" name="customer[code]" id="code" class="mm-input" placeholder="e.g. 101" min="1" required>
      </div>

      <!-- First & Last Name Grid -->
      <div class="form-grid-2">
        <div class="mm-form-group">
          <label class="mm-label" for="first">First Name *</label>
          <input type="text" name="customer[first]" id="first" class="mm-input" placeholder="e.g. Ramesh" required>
        </div>

        <div class="mm-form-group">
          <label class="mm-label" for="last">Last Name *</label>
          <input type="text" name="customer[last]" id="last" class="mm-input" placeholder="e.g. Patel" required>
        </div>
      </div>

      <!-- Contact Phone -->
      <div class="mm-form-group">
        <label class="mm-label" for="contact">10-Digit Mobile Number *</label>
        <input type="tel" name="customer[contact]" id="contact" class="mm-input" placeholder="e.g. 9879638521" maxlength="10" required>
      </div>

      <!-- Physical Address -->
      <div class="mm-form-group">
        <label class="mm-label" for="address">Customer Village / Residential Address *</label>
        <input type="text" name="customer[address]" id="address" class="mm-input" placeholder="e.g. House No. 24, Near Gram Panchayat" required>
      </div>

      <div class="add-cust-footer">
        <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg" style="width:100%;">
          <i class="fa-solid fa-check"></i> Save Customer Profile
        </button>
        <a href="/dairy" class="mm-btn mm-btn-secondary" style="width:100%; text-align:center;">
          <i class="fa-solid fa-arrow-left"></i> Cancel & Return to Dashboard
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('../includes/footer.ejs') %>
