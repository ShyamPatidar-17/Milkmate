<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/dairy/index.css" />

<div class="table-page-container">
  <!-- Table Header Bar -->
  <div class="table-header-bar">
    <div class="table-header-title">
      <h2><i class="fa-solid fa-users" style="color:#059669;"></i> Dairy Customer Directory</h2>
      <p>Farmers and milk suppliers registered under Dairy #<%= currUser ? currUser.dairyCode : '' %></p>
    </div>

    <div class="table-controls">
      <div class="search-input-wrapper">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="Search by Code, Name, or Phone...">
      </div>

      <a href="/customers/add" class="mm-btn mm-btn-primary">
        <i class="fa-solid fa-user-plus"></i> Add New Customer
      </a>
      <a href="/dairy" class="mm-btn mm-btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Dashboard
      </a>
    </div>
  </div>

  <!-- Data Card -->
  <div class="data-card">
    <% if (!allCustomer || allCustomer.length === 0) { %>
      <div class="empty-table-state">
        <div class="empty-icon"><i class="fa-solid fa-user-slash"></i></div>
        <h3>No Customers Found</h3>
        <p>You haven't enrolled any customers yet under this dairy center.</p>
        <a href="/customers/add" class="mm-btn mm-btn-primary">
          <i class="fa-solid fa-user-plus"></i> Add Your First Customer
        </a>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="modern-table" id="customerTable">
          <thead>
            <tr>
              <th>Customer Code</th>
              <th>Customer Name</th>
              <th>Contact</th>
              <th>Address</th>
              <th>Account Balance Status</th>
              <th style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% for (const customer of allCustomer) { %>
              <tr>
                <td>
                  <span class="code-badge">#<%= customer.code %></span>
                </td>
                <td>
                  <div class="customer-name-cell">
                    <div class="avatar-circle">
                      <%= (customer.first ? customer.first.charAt(0) : 'C').toUpperCase() %>
                    </div>
                    <div>
                      <strong><%= customer.first %> <%= customer.last %></strong>
                    </div>
                  </div>
                </td>
                <td>
                  <a href="tel:<%= customer.contact %>" class="phone-link">
                    <i class="fa-solid fa-phone" style="font-size:0.8rem;"></i> <%= customer.contact %>
                  </a>
                </td>
                <td><%= customer.address || '—' %></td>
                <td>
                  <% if (customer.isCleared) { %>
                    <span style="display:inline-flex; align-items:center; gap:5px; background:#ecfdf5; color:#059669; border:1px solid #a7f3d0; padding:4px 10px; border-radius:9999px; font-size:0.78rem; font-weight:800;">
                      <i class="fa-solid fa-circle-check"></i> 100% Cleared
                    </span>
                  <% } else if (customer.totalSettled > 0 && customer.netPending > 0) { %>
                    <span style="display:inline-flex; align-items:center; gap:5px; background:#fffbeb; color:#d97706; border:1px solid #fde68a; padding:4px 10px; border-radius:9999px; font-size:0.78rem; font-weight:800;">
                      <i class="fa-solid fa-clock-rotate-left"></i> Partial &bull; ₹<%= customer.netPending.toFixed(2) %> Due
                    </span>
                  <% } else if (customer.netPending > 0) { %>
                    <span style="display:inline-flex; align-items:center; gap:5px; background:#fef2f2; color:#dc2626; border:1px solid #fecaca; padding:4px 10px; border-radius:9999px; font-size:0.78rem; font-weight:800;">
                      <i class="fa-solid fa-hourglass-half"></i> ₹<%= customer.netPending.toFixed(2) %> Due
                    </span>
                  <% } else { %>
                    <span style="color:#64748b; font-size:0.85rem; font-weight:600;">No Dues</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <a href="/customers/<%= customer._id %>" class="mm-btn mm-btn-primary mm-btn-sm">
                    <i class="fa-solid fa-file-lines"></i> View Passbook
                  </a>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div id="noResults" style="text-align:center; padding: 40px; display:none; color:#64748b;">
        <i class="fa-solid fa-search" style="font-size:2rem; margin-bottom:8px; display:block; color:#cbd5e1;"></i>
        <strong>No matching customers found.</strong> Try adjusting your search query.
      </div>
    <% } %>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  const searchInput = document.getElementById('searchInput');
  const table = document.getElementById('customerTable');
  const rows = table ? table.querySelectorAll('tbody tr') : [];
  const noResults = document.getElementById('noResults');

  if (searchInput && table) {
    searchInput.addEventListener('input', function () {
      const filter = this.value.toLowerCase().trim();
      let visibleCount = 0;

      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        if (text.includes(filter)) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  }
</script>
