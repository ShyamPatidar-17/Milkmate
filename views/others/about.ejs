<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/others/about.css">

<!-- About Hero -->
<section class="about-hero">
  <div class="about-hero-content">
    <span class="mm-badge mm-badge-primary" style="margin-bottom:12px;">
      <i class="fa-solid fa-heart"></i> Our Mission & Story
    </span>
    <h1>Empowering India's Dairy Ecosystem</h1>
    <p>
      MilkMate is an intelligent dairy management platform engineered to modernize rural and urban dairy operations, replacing tedious manual registers with transparent real-time ledgers.
    </p>
  </div>
</section>

<!-- Main Container -->
<section class="about-main-container">
  <!-- Split Row 1 -->
  <div class="about-split-row">
    <div class="about-text-box">
      <span class="mm-badge mm-badge-primary" style="margin-bottom:10px;">Who We Are</span>
      <h3>Built for Farmers, Cooperatives & Doorstep Vendors</h3>
      <p>
        Across thousands of dairy hubs, milk intake and distribution records are still jotted down in vulnerable paper notebooks. Discrepancies in liters and fat rates often lead to disputes and delayed farmer payments.
      </p>
      <p>
        MilkMate bridges this gap by unifying dairy collection centers, independent milkmen, and household consumers under one single trusted platform.
      </p>
    </div>
    <div class="about-img-box">
      <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=800&q=80" alt="Dairy Cattle on Farm">
    </div>
  </div>

  <!-- Split Row 2 -->
  <div class="about-split-row reverse">
    <div class="about-text-box">
      <span class="mm-badge mm-badge-accent" style="margin-bottom:10px;">Our Vision</span>
      <h3>Farm-Fresh Quality with Digital Transparency</h3>
      <p>
        We believe dairy farming should be profitable and fair. By offering automated shift pricing (Liters &times; Rate), instant calculation of dues, and one-click settlements, we ensure every farmer receives their rightful income on time.
      </p>
      <p>
        Simultaneously, our integrated store allows dairy centers and vendors to retail pure artisanal ghee, paneer, and butter directly to households.
      </p>
    </div>
    <div class="about-img-box">
      <img src="https://images.unsplash.com/photo-1527153857715-3908f2ae5e81?auto=format&fit=crop&w=800&q=80" alt="Fresh Milk Production">
    </div>
  </div>

  <!-- 4 Pillars of Excellence -->
  <div style="text-align:center; margin-top:50px;">
    <span class="mm-badge mm-badge-primary">Core Values</span>
    <h2 style="font-size:2rem; font-weight:800; color:#0f172a; margin-top:8px;">The MilkMate Advantage</h2>
  </div>

  <div class="values-grid">
    <div class="value-card">
      <div class="value-icon"><i class="fa-solid fa-calculator"></i></div>
      <h4>Accurate Pricing</h4>
      <p>Instant shift calculations based on precise quantity and fat rates with zero arithmetic errors.</p>
    </div>

    <div class="value-card">
      <div class="value-icon" style="background:#f0f9ff; color:#0284c7;"><i class="fa-solid fa-mobile-screen-button"></i></div>
      <h4>Digital Passbook</h4>
      <p>Customers and farmers can check their daily intake history anytime from their phones.</p>
    </div>

    <div class="value-card">
      <div class="value-icon" style="background:#fef3c7; color:#d97706;"><i class="fa-solid fa-coins"></i></div>
      <h4>Fast Settlements</h4>
      <p>1-Click ledger reconciliation with clear balance statements and settlement records.</p>
    </div>

    <div class="value-card">
      <div class="value-icon" style="background:#f5f3ff; color:#7c3aed;"><i class="fa-solid fa-shop"></i></div>
      <h4>Direct E-Commerce</h4>
      <p>Empowering local dairies to sell fresh value-added products like ghee and paneer online.</p>
    </div>
  </div>
</section>

