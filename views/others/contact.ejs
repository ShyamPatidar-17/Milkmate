        </div>

        <div class="google-form-iframe-container">
          <iframe 
            src="https://docs.google.com/forms/d/e/1FAIpQLSdX4uY6X3q0-dummy-milkmate/viewform?embedded=true" 
            width="100%" 
            height="560" 
            frameborder="0" 
            marginheight="0" 
            marginwidth="0" 
            class="google-form-iframe"
            title="MilkMate Contact Google Form">
            Loading Google Form…
          </iframe>
        </div>

        <div class="google-form-footer">
          <i class="fa-solid fa-circle-info"></i>
          <span>Having trouble loading the form? <a href="https://docs.google.com/forms/d/e/1FAIpQLSdX4uY6X3q0-dummy-milkmate/viewform" target="_blank" rel="noopener noreferrer">Click here to open Google Form directly</a>.</span>
        </div>
      </div>
    </div>
