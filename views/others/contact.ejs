              <strong>Secure & Confidential</strong>
              <p>Powered by Google Forms infrastructure with strict data confidentiality.</p>
            </div>
          </div>
        </div>

        <div class="touch-direct-cta">
          <a href="https://docs.google.com/forms/d/e/1FAIpQLSdX4uY6X3q0-dummy-milkmate/viewform" target="_blank" rel="noopener noreferrer" class="mm-btn mm-btn-primary mm-btn-lg" style="width:100%; text-align:center;">
            <i class="fa-brands fa-google"></i> Open Google Form in New Tab <i class="fa-solid fa-arrow-up-right-from-square" style="font-size:0.8rem;"></i>
          </a>
          <span class="direct-cta-subtext"><i class="fa-solid fa-circle-check" style="color:#10b981;"></i> Opens in a secure new browser window</span>
        </div>
      </div>

      <!-- Right Column: Interactive / Embedded Google Form Container -->
      <div class="google-form-card">
        <div class="google-form-toolbar">
