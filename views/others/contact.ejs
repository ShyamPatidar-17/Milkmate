          <a href="https://docs.google.com/forms/d/e/1FAIpQLSdX4uY6X3q0-dummy-milkmate/viewform" target="_blank" rel="noopener noreferrer" class="gform-fullscreen-link" title="Open full screen in new tab">
            <i class="fa-solid fa-up-right-from-square"></i> Fullscreen
