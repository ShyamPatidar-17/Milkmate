<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/customers/front.css">

<div class="dashboard-wrapper">
  <!-- Welcome Profile Banner -->
  <div class="dash-welcome-card">
    <div class="dash-welcome-info">
      <h1>Hello, <%= user.name || 'Valued Customer' %> 👋</h1>
      <p>Customer Passbook & Fresh Dairy Products Hub</p>
    </div>

    <div class="dash-profile-badges">
      <div class="dash-badge-chip">
        <i class="fa-solid fa-id-card"></i>
        <span>Customer Code: <strong><%= user.code %></strong></span>
      </div>
      <div class="dash-badge-chip">
        <i class="fa-solid fa-building-wheat"></i>
        <span>Dairy Code: <strong><%= user.dairyCode %></strong></span>
      </div>
      <div class="dash-badge-chip">
        <i class="fa-solid fa-calendar-day"></i>
        <span id="currentDateStr">Live Operations</span>
      </div>
    </div>
  </div>

  <!-- Profile Details Card -->
  <div class="customer-profile-card">
    <div class="profile-meta-item">
      <span class="profile-meta-label">Customer Name</span>
      <span class="profile-meta-value"><%= user.name || 'Not Available' %></span>
    </div>
    <div class="profile-meta-item">
      <span class="profile-meta-label">Mobile Contact</span>
      <span class="profile-meta-value">+91 <%= user.mobile || 'Not Available' %></span>
    </div>
    <div class="profile-meta-item">
      <span class="profile-meta-label">Dairy Center</span>
      <span class="profile-meta-value">Center #<%= user.dairyCode %></span>
    </div>
    <div class="profile-meta-item">
      <span class="profile-meta-label">Delivery Address</span>
      <span class="profile-meta-value"><%= user.address || 'Local Customer' %></span>
    </div>
  </div>

  <!-- Core Actions Grid -->
  <h2 class="dash-section-title">
    <i class="fa-solid fa-grid-2"></i> Customer Services
  </h2>

  <div class="dash-actions-grid">
    <!-- Action 1: My Milk Ledger / Passbook -->
    <a href="/customerrs/details" class="action-tile">
      <div class="action-tile-icon" style="background:#ecfdf5; color:#059669;">
        <i class="fa-solid fa-receipt"></i>
      </div>
      <h4>Milk Passbook & Dues <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>View your complete daily milk intake history, fat rates, liters delivered, and cumulative bill amount.</p>
      <div class="tile-footer">View Passbook &rarr;</div>
    </a>

    <!-- Action 2: Fresh Dairy Store -->
    <a href="/product/all" class="action-tile">
      <div class="action-tile-icon" style="background:#fef3c7; color:#d97706;">
        <i class="fa-solid fa-store"></i>
      </div>
      <h4>Farm Fresh Dairy Store <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>Shop pure farm-made ghee, freshly pressed paneer, curd, and organic butter directly from local dairies.</p>
      <div class="tile-footer">Browse Products &rarr;</div>
    </a>

    <!-- Action 3: Cart & Orders -->
    <a href="/cart" class="action-tile">
      <div class="action-tile-icon" style="background:#f0f9ff; color:#0284c7;">
        <i class="fa-solid fa-cart-shopping"></i>
      </div>
      <h4>My Shopping Cart <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>Review items in your shopping bag, update quantities, calculate shipping, and checkout securely.</p>
      <div class="tile-footer">Open Shopping Cart &rarr;</div>
    </a>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  const dateOptions = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
  document.getElementById('currentDateStr').textContent = new Date().toLocaleDateString('en-IN', dateOptions);
</script>
