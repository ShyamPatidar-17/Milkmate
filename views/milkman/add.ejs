<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/dairy/addcustomer.css">

<div class="add-cust-wrapper">
  <div class="add-cust-card">
    <div class="add-cust-head">
      <span class="add-cust-badge" style="background:#f0f9ff; color:#0284c7; border-color:#bae6fd;">
        <i class="fa-solid fa-truck-fast"></i> Route Customer Enrollment
      </span>
      <h2>Add Delivery Customer</h2>
      <p>Enroll a household under Milkman #<%= user.milkmanCode %></p>
    </div>

    <form action="/milkman" method="POST" id="addMilkmanCustomerForm">
      <!-- Hidden Milkman Code -->
      <input type="hidden" name="customer[milkmanCode]" value="<%= user.milkmanCode %>">

      <!-- Customer Code -->
      <div class="mm-form-group">
        <label class="mm-label" for="code">Customer Code *</label>
        <input type="number" name="customer[code]" id="code" class="mm-input" placeholder="e.g. 101" min="1" required>
      </div>

      <!-- First & Last Name Grid -->
      <div class="form-grid-2">
        <div class="mm-form-group">
          <label class="mm-label" for="first">First Name *</label>
          <input type="text" name="customer[first]" id="first" class="mm-input" placeholder="e.g. Amit" required>
        </div>

        <div class="mm-form-group">
          <label class="mm-label" for="last">Last Name *</label>
          <input type="text" name="customer[last]" id="last" class="mm-input" placeholder="e.g. Verma" required>
        </div>
      </div>

      <!-- Contact Phone -->
      <div class="mm-form-group">
        <label class="mm-label" for="contact">10-Digit Mobile Number *</label>
        <input type="tel" name="customer[contact]" id="contact" class="mm-input" placeholder="e.g. 9826012345" maxlength="10" required>
      </div>

      <!-- Home Delivery Address -->
      <div class="mm-form-group">
        <label class="mm-label" for="address">Home Delivery Address *</label>
        <input type="text" name="customer[address]" id="address" class="mm-input" placeholder="e.g. Flat 302, Green Avenue, Main Road" required>
      </div>

      <div class="add-cust-footer">
        <button type="submit" class="mm-btn mm-btn-accent mm-btn-lg" style="width:100%;">
          <i class="fa-solid fa-check"></i> Save Route Customer
        </button>
        <a href="/milkman" class="mm-btn mm-btn-secondary" style="width:100%; text-align:center;">
          <i class="fa-solid fa-arrow-left"></i> Cancel & Return to Dashboard
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('../includes/footer.ejs') %>
