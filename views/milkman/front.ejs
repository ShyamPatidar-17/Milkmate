<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/milkman/front.css">

<div class="dashboard-wrapper">
  <!-- Welcome Profile Banner -->
  <div class="dash-welcome-card">
    <div class="dash-welcome-info">
      <h1><%= user.name || 'Milkman Operations' %></h1>
      <p>Milk Delivery Vendor Portal &bull; Daily Distribution Hub</p>
    </div>

    <div class="dash-profile-badges">
      <div class="dash-badge-chip">
        <i class="fa-solid fa-hashtag"></i>
        <span>Milkman Code: <strong><%= user.milkmanCode %></strong></span>
      </div>
      <div class="dash-badge-chip">
        <i class="fa-solid fa-phone"></i>
        <span>+91 <%= user.mobile %></span>
      </div>
      <div class="dash-badge-chip">
        <i class="fa-solid fa-calendar-day"></i>
        <span id="currentDateStr">Live Operations</span>
      </div>
    </div>
  </div>

  <!-- Quick Stats Bar -->
  <div class="dash-stats-grid">
    <div class="stat-card">
      <div class="stat-icon" style="background:#f0f9ff; color:#0284c7;">
        <i class="fa-solid fa-truck-ramp-box"></i>
      </div>
      <div class="stat-info">
        <h3>Doorstep Delivery</h3>
        <p>Morning / Evening Drops</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon" style="background:#ecfdf5; color:#059669;">
        <i class="fa-solid fa-receipt"></i>
      </div>
      <div class="stat-info">
        <h3>Customer Ledgers</h3>
        <p>Auto-Updated Balance</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon" style="background:#fef3c7; color:#d97706;">
        <i class="fa-solid fa-shop"></i>
      </div>
      <div class="stat-info">
        <h3>Retail Dairy Goods</h3>
        <p>Direct Sales Enabled</p>
      </div>
    </div>
  </div>

  <!-- Core Actions Grid -->
  <h2 class="dash-section-title">
    <i class="fa-solid fa-grid-2"></i> Distribution Modules
  </h2>

  <div class="dash-actions-grid">
    <!-- Action 1: Sell Milk -->
    <a href="/milkman/sell" class="action-tile">
      <div class="action-tile-icon" style="background:#ecfdf5; color:#059669;">
        <i class="fa-solid fa-bottle-droplet"></i>
      </div>
      <h4>Record Milk Delivery (Sell) <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>Log morning or evening milk delivered to household customers with quantity, rate, and date.</p>
      <div class="tile-footer">Log Delivery Entry &rarr;</div>
    </a>

    <!-- Action 2: Customer Directory -->
    <a href="/milkman/allcustomers" class="action-tile">
      <div class="action-tile-icon" style="background:#f0f9ff; color:#0284c7;">
        <i class="fa-solid fa-users"></i>
      </div>
      <h4>Customer Route Directory <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>Search and manage all regular households and customers on your milk distribution routes.</p>
      <div class="tile-footer">View Route Customers &rarr;</div>
    </a>

    <!-- Action 3: Add Customer -->
    <a href="/milkman/add" class="action-tile">
      <div class="action-tile-icon" style="background:#fef3c7; color:#d97706;">
        <i class="fa-solid fa-user-plus"></i>
      </div>
      <h4>Add New Household Customer <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>Enroll a new delivery customer with code, contact number, and home delivery address.</p>
      <div class="tile-footer">Enroll New Customer &rarr;</div>
    </a>

    <!-- Action 4: Milk Sales Details -->
    <a href="/milkman/details" class="action-tile">
      <div class="action-tile-icon" style="background:#f5f3ff; color:#7c3aed;">
        <i class="fa-solid fa-file-invoice-dollar"></i>
      </div>
      <h4>Sales Ledger & Payouts <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>Check total milk delivered, total earnings accumulated, and clear or settle customer balances.</p>
      <div class="tile-footer">Sales & Billing Summary &rarr;</div>
    </a>

    <!-- Action 5: Product Catalog -->
    <a href="/product" class="action-tile">
      <div class="action-tile-icon" style="background:#fff1f2; color:#e11d48;">
        <i class="fa-solid fa-box-open"></i>
      </div>
      <h4>Manage Products Store <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>List packaged milk, homemade ghee, fresh butter, or paneer for sale to regular customers.</p>
      <div class="tile-footer">Store Catalog &rarr;</div>
    </a>

    <!-- Action 6: Customer View -->
    <a href="/product/all" class="action-tile">
      <div class="action-tile-icon" style="background:#ecfdf5; color:#059669;">
        <i class="fa-solid fa-store"></i>
      </div>
      <h4>Customer Storefront <i class="fa-solid fa-arrow-right arrow-icon"></i></h4>
      <p>Preview products and check available inventory from the perspective of a consumer.</p>
      <div class="tile-footer">Preview Marketplace &rarr;</div>
    </a>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  const dateOptions = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
  document.getElementById('currentDateStr').textContent = new Date().toLocaleDateString('en-IN', dateOptions);
</script>
