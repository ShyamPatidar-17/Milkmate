<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/dairy/edit.css">

<div class="edit-cust-wrapper">
  <div class="edit-cust-card">
    <div class="edit-cust-head">
      <span class="edit-cust-badge" style="background:#f0f9ff; color:#0284c7; border-color:#bae6fd;">
        <i class="fa-solid fa-pen-to-square"></i> Route Customer Profile
      </span>
      <h2>Edit Household Customer</h2>
      <p>Updating profile for Route Customer #<%= customer.code %></p>
    </div>

    <form action="/milkman/<%= customer._id %>?_method=PUT" method="POST" id="editMilkmanCustomerForm">
      <!-- Customer Code -->
      <div class="mm-form-group">
        <label class="mm-label" for="code">Customer Code</label>
        <input type="number" name="customer[code]" id="code" class="mm-input" value="<%= customer.code %>" required>
      </div>

      <!-- First & Last Name Grid -->
      <div class="form-grid-2">
        <div class="mm-form-group">
          <label class="mm-label" for="first">First Name *</label>
          <input type="text" name="customer[first]" id="first" class="mm-input" value="<%= customer.first %>" required>
        </div>

        <div class="mm-form-group">
          <label class="mm-label" for="last">Last Name *</label>
          <input type="text" name="customer[last]" id="last" class="mm-input" value="<%= customer.last %>" required>
        </div>
      </div>

      <!-- Contact Phone -->
      <div class="mm-form-group">
        <label class="mm-label" for="contact">Mobile Contact *</label>
        <input type="tel" name="customer[contact]" id="contact" class="mm-input" value="<%= customer.contact %>" maxlength="10" required>
      </div>

      <!-- Address -->
      <div class="mm-form-group">
        <label class="mm-label" for="address">Delivery Address *</label>
        <input type="text" name="customer[address]" id="address" class="mm-input" value="<%= customer.address %>" required>
      </div>

      <div class="edit-cust-footer">
        <button type="submit" class="mm-btn mm-btn-accent mm-btn-lg" style="width:100%;">
          <i class="fa-solid fa-floppy-disk"></i> Save Changes
        </button>
        <a href="/milkman/<%= customer._id %>" class="mm-btn mm-btn-secondary" style="width:100%; text-align:center;">
          <i class="fa-solid fa-arrow-left"></i> Cancel & Return
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('../includes/footer.ejs') %>
