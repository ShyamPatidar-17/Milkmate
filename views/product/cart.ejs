<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/product/cart.css">

<!-- Non-intrusive Toast for Cart Updates -->
<div id="cart-ajax-toast" class="cart-toast" style="display:none;">
  <i class="fa-solid fa-circle-check"></i>
  <span id="cart-toast-text">Cart updated</span>
</div>

<div class="cart-page-wrapper">
  <div class="cart-header">
    <h1><i class="fa-solid fa-cart-shopping" style="color:#059669;"></i> Your Shopping Bag</h1>
    <a href="/product/all" class="mm-btn mm-btn-secondary">
      <i class="fa-solid fa-arrow-left"></i> Continue Shopping
    </a>
  </div>

  <div id="cart-content-container">
    <% if (!cart || cart.length === 0) { %>
      <div class="empty-cart-card" id="emptyCartView">
        <div class="empty-cart-icon"><i class="fa-solid fa-basket-shopping"></i></div>
        <h2 style="font-size:1.6rem; font-weight:800; color:#0f172a; margin-bottom:8px;">Your Cart is Empty</h2>
        <p style="color:#64748b; margin-bottom:24px; max-width:400px; margin-left:auto; margin-right:auto;">
          Explore our farm-fresh dairy collection including pure desi ghee, fresh paneer, organic curd, and artisan butter!
        </p>
        <a href="/product/all" class="mm-btn mm-btn-primary mm-btn-lg">
          <i class="fa-solid fa-store"></i> Explore Fresh Dairy Store
        </a>
      </div>
    <% } else { %>
      <div class="cart-grid-layout" id="cartGridLayout">
        <!-- Left: Item Rows -->
        <div class="cart-items-card">
          <% cart.forEach(item => { 
            const defaultImg = "https://images.unsplash.com/photo-1550583724-b2692b85b150?auto=format&fit=crop&w=400&q=80";
            const itemImg = (item.image && item.image.trim()) ? item.image : defaultImg;
          %>
            <div class="cart-item-row" id="cart-item-<%= item.productId %>" data-product-id="<%= item.productId %>">
              <div class="cart-item-info">
                <!-- Product Image -->
                <div class="cart-item-img-box">
                  <img src="<%= itemImg %>" alt="<%= item.name %>" class="cart-item-img" onerror="this.onerror=null; this.src='<%= defaultImg %>';">
                </div>
                <div class="cart-item-details">
                  <h4><%= item.name %></h4>
                  <p>₹<%= Number(item.price).toFixed(2) %> per unit</p>
                </div>
              </div>

              <!-- Quantity Stepper (AJAX - No Page Refresh) -->
              <div class="qty-stepper-form">
                <button type="button" class="qty-btn" data-action="decrease" data-product-id="<%= item.productId %>" title="Decrease Quantity">-</button>
                <span class="qty-display" id="qty-<%= item.productId %>"><%= item.quantity %></span>
                <button type="button" class="qty-btn" data-action="increase" data-product-id="<%= item.productId %>" title="Increase Quantity">+</button>
              </div>

              <!-- Line Subtotal -->
              <div class="cart-item-subtotal" id="subtotal-<%= item.productId %>">
                ₹<%= (item.price * item.quantity).toFixed(2) %>
              </div>

              <!-- Remove Button (AJAX - No Page Refresh) -->
              <button type="button" class="cart-remove-btn" data-product-id="<%= item.productId %>" data-product-name="<%= item.name %>" title="Remove Item">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </div>
          <% }); %>
        </div>

        <!-- Right: Order Summary -->
        <div class="cart-summary-card">
          <h3>Order Summary</h3>

          <div class="summary-line">
            <span>Items Subtotal (<span id="summary-items-count"><%= cart.length %> items</span>)</span>
            <span id="summary-subtotal">₹<%= totalAmount.toFixed(2) %></span>
          </div>

          <div class="summary-line">
            <span>Farm Fresh Packaging</span>
            <span style="color:#059669; font-weight:600;">FREE</span>
          </div>

          <div class="summary-line">
            <span>Delivery Standard</span>
            <span style="color:#059669; font-weight:600;">FREE</span>
          </div>

          <div class="summary-total-line">
            <span>Total Payable</span>
            <span class="summary-total-price" id="summary-total">₹<%= totalAmount.toFixed(2) %></span>
          </div>

          <div class="summary-guarantee">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Guaranteed 100% Pure & Farm Sourced</span>
          </div>

          <form action="/cart/checkout" method="GET" style="margin-top:24px;">
            <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg" style="width:100%;">
              <i class="fa-solid fa-credit-card"></i> Proceed to Checkout
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  // Show non-intrusive floating toast
  function showToast(message) {
    const toast = document.getElementById('cart-ajax-toast');
    const toastText = document.getElementById('cart-toast-text');
    if (toast && toastText) {
      toastText.textContent = message;
      toast.style.display = 'flex';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 2000);
    }
  }

  // Update floating dock counter or navbar if present
  function updateGlobalCounters(count) {
    const dockCounter = document.getElementById('cart-count');
    const btnCounter = document.getElementById('cart-counter-btn');
    if (dockCounter) dockCounter.textContent = count;
    if (btnCounter) btnCounter.textContent = count;
  }

  // Render empty cart HTML dynamically without page reload
  function renderEmptyCart() {
    const container = document.getElementById('cart-content-container');
    if (container) {
      container.innerHTML = `
        <div class="empty-cart-card" id="emptyCartView" style="animation: mmFadeIn 0.4s ease both;">
          <div class="empty-cart-icon"><i class="fa-solid fa-basket-shopping"></i></div>
          <h2 style="font-size:1.6rem; font-weight:800; color:#0f172a; margin-bottom:8px;">Your Cart is Empty</h2>
          <p style="color:#64748b; margin-bottom:24px; max-width:400px; margin-left:auto; margin-right:auto;">
            Explore our farm-fresh dairy collection including pure desi ghee, fresh paneer, organic curd, and artisan butter!
          </p>
          <a href="/product/all" class="mm-btn mm-btn-primary mm-btn-lg">
            <i class="fa-solid fa-store"></i> Explore Fresh Dairy Store
          </a>
        </div>
      `;
    }
  }

  // Handle Quantity Increase / Decrease (+/-) via AJAX without page reload
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.qty-btn');
    if (!btn) return;

    e.preventDefault();
    const action = btn.dataset.action;
    const productId = btn.dataset.productId;
    if (!action || !productId) return;

    // Disable button to prevent rapid double-clicks
    btn.disabled = true;

    try {
      const res = await fetch(`/cart/update/${productId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ action })
      });

      if (res.ok) {
        const data = await res.json();
        if (data.success) {
          if (data.itemRemoved) {
            // Smoothly remove item row
            const row = document.getElementById(`cart-item-${productId}`);
            if (row) {
              row.classList.add('removing');
              setTimeout(() => {
                row.remove();
                if (data.cartItemsCount === 0) {
                  renderEmptyCart();
                }
              }, 350);
            }
            showToast('Item removed from cart');
          } else {
            // Update quantity display
            const qtySpan = document.getElementById(`qty-${productId}`);
            if (qtySpan) qtySpan.textContent = data.quantity;

            // Update subtotal display
            const subtotalDiv = document.getElementById(`subtotal-${productId}`);
            if (subtotalDiv) subtotalDiv.textContent = `₹${data.itemSubtotal}`;

            showToast(action === 'increase' ? 'Quantity increased' : 'Quantity decreased');
          }

          // Update order summary
          const summarySubtotal = document.getElementById('summary-subtotal');
          const summaryTotal = document.getElementById('summary-total');
          const summaryCount = document.getElementById('summary-items-count');

          if (summarySubtotal) summarySubtotal.textContent = `₹${data.totalAmount}`;
          if (summaryTotal) summaryTotal.textContent = `₹${data.totalAmount}`;
          if (summaryCount) summaryCount.textContent = `${data.cartItemsCount} items`;

          updateGlobalCounters(data.cartCount);
        }
      } else {
        console.error('Failed to update cart');
      }
    } catch (err) {
      console.error('AJAX quantity update error:', err);
    } finally {
      btn.disabled = false;
    }
  });

  // Handle Item Removal via AJAX without page reload
  document.addEventListener('click', async (e) => {
    const removeBtn = e.target.closest('.cart-remove-btn');
    if (!removeBtn) return;

    e.preventDefault();
    const productId = removeBtn.dataset.productId;
    const productName = removeBtn.dataset.productName || 'this item';
    if (!productId) return;

    if (!confirm(`Remove ${productName} from your cart?`)) {
      return;
    }

    removeBtn.disabled = true;

    try {
      const res = await fetch(`/cart/delete/${productId}`, {
        method: 'DELETE',
        headers: {
          'Accept': 'application/json'
        }
      });

      if (res.ok) {
        const data = await res.json();
        if (data.success) {
          const row = document.getElementById(`cart-item-${productId}`);
          if (row) {
            row.classList.add('removing');
            setTimeout(() => {
              row.remove();
              if (data.cartItemsCount === 0) {
                renderEmptyCart();
              }
            }, 350);
          }

          // Update order summary
          const summarySubtotal = document.getElementById('summary-subtotal');
          const summaryTotal = document.getElementById('summary-total');
          const summaryCount = document.getElementById('summary-items-count');

          if (summarySubtotal) summarySubtotal.textContent = `₹${data.totalAmount}`;
          if (summaryTotal) summaryTotal.textContent = `₹${data.totalAmount}`;
          if (summaryCount) summaryCount.textContent = `${data.cartItemsCount} items`;

          updateGlobalCounters(data.cartCount);
          showToast('Item removed from cart');
        }
      } else {
        console.error('Failed to delete item from cart');
      }
    } catch (err) {
      console.error('AJAX delete item error:', err);
    } finally {
      removeBtn.disabled = false;
    }
  });
</script>
