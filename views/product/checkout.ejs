<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/product/checkout.css">

<div class="checkout-page-wrapper">
  <div class="checkout-header">
    <h1><i class="fa-solid fa-lock" style="color:#059669;"></i> Secure Checkout</h1>
    <p>Complete your delivery and payment details to place your fresh dairy order.</p>
  </div>

  <div class="checkout-grid">
    <!-- Left Column: Checkout Details Form -->
    <div class="checkout-form-card">
      <form action="/cart/pay" method="POST" id="checkoutForm">
        <h3 class="checkout-section-title">
          <i class="fa-solid fa-truck"></i> Delivery Information
        </h3>

        <!-- Full Name -->
        <div class="mm-form-group">
          <label class="mm-label" for="fullname">Full Name *</label>
          <input type="text" id="fullname" name="fullname" class="mm-input" value="<%= user ? (user.name || user.first || '') : '' %>" required>
        </div>

        <!-- Contact Number -->
        <div class="mm-form-group">
          <label class="mm-label" for="contact">10-Digit Mobile Number *</label>
          <input type="tel" id="contact" name="contact" class="mm-input" value="<%= user ? user.mobile : '' %>" required maxlength="10">
        </div>

        <!-- Delivery Address -->
        <div class="mm-form-group">
          <label class="mm-label" for="address">Complete Delivery Address *</label>
          <textarea id="address" name="address" rows="3" class="mm-textarea" required placeholder="House/Flat No., Landmark, Street, City, Pin Code"><%= user ? (user.address || '') : '' %></textarea>
        </div>

        <!-- Payment Method Section -->
        <h3 class="checkout-section-title" style="margin-top:32px;">
          <i class="fa-solid fa-wallet"></i> Choose Payment Method
        </h3>

        <!-- Hidden input storing chosen method -->
        <input type="hidden" name="payment" id="paymentInput" value="cod">

        <div class="payment-methods-grid">
          <div class="payment-card-option active" data-method="cod" onclick="setPaymentMethod('cod')">
            <i class="fa-solid fa-hand-holding-dollar"></i>
            <span>Cash on Delivery</span>
          </div>

          <div class="payment-card-option" data-method="upi" onclick="setPaymentMethod('upi')">
            <i class="fa-solid fa-qrcode"></i>
            <span>UPI / QR</span>
          </div>

          <div class="payment-card-option" data-method="card" onclick="setPaymentMethod('card')">
            <i class="fa-solid fa-credit-card"></i>
            <span>Credit / Debit Card</span>
          </div>
        </div>

        <!-- UPI Details Box -->
        <div id="upi-details" class="upi-box" style="display:none;">
          <label class="mm-label" for="upiId">Enter Your UPI ID (VPA)</label>
          <input type="text" id="upiId" name="upiId" class="mm-input" placeholder="e.g. yourname@oksbi / 9879638521@paytm">
          <small style="color:#059669; font-size:0.82rem; margin-top:6px; display:block;">
            <i class="fa-solid fa-shield"></i> Instant simulated UPI verification for demo checkout.
          </small>
        </div>

        <!-- Card Details Box -->
        <div id="card-details" class="card-box" style="display:none;">
          <div class="mm-form-group">
            <label class="mm-label" for="cardNumber">Card Number</label>
            <input type="text" id="cardNumber" name="cardNumber" class="mm-input" placeholder="XXXX-XXXX-XXXX-XXXX" maxlength="19">
          </div>
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
            <div class="mm-form-group">
              <label class="mm-label" for="cardExpiry">Expiry Date</label>
              <input type="text" id="cardExpiry" name="cardExpiry" class="mm-input" placeholder="MM/YY" maxlength="5">
            </div>
            <div class="mm-form-group">
              <label class="mm-label" for="cardCVC">CVV</label>
              <input type="password" id="cardCVC" name="cardCVC" class="mm-input" placeholder="123" maxlength="3">
            </div>
          </div>
        </div>

        <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg" style="width:100%; margin-top:20px;">
          <i class="fa-solid fa-circle-check"></i> Place Order (₹<%= totalAmount.toFixed(2) %>)
        </button>
      </form>
    </div>

    <!-- Right Column: Order Summary -->
    <div class="checkout-summary-card">
      <h3 style="font-size:1.3rem; font-weight:800; color:#0f172a; margin-bottom:16px;">Order Summary</h3>

      <ul class="checkout-items-list">
        <% cart.forEach(item => { %>
          <li class="checkout-item-item">
            <div>
              <strong><%= item.name %></strong>
              <div style="font-size:0.8rem; color:#64748b;">Qty: <%= item.quantity %> &times; ₹<%= item.price %></div>
            </div>
            <div style="font-weight:700; color:#0f172a;">
              ₹<%= (item.price * item.quantity).toFixed(2) %>
            </div>
          </li>
        <% }); %>
      </ul>

      <div class="summary-line" style="display:flex; justify-content:space-between; margin-bottom:8px; color:#64748b;">
        <span>Subtotal</span>
        <span>₹<%= totalAmount.toFixed(2) %></span>
      </div>

      <div class="summary-line" style="display:flex; justify-content:space-between; margin-bottom:8px; color:#64748b;">
        <span>Delivery Charge</span>
        <span style="color:#059669; font-weight:600;">FREE</span>
      </div>

      <div class="summary-total-line" style="display:flex; justify-content:space-between; margin-top:16px; padding-top:14px; border-top:2px dashed #e2e8f0; font-size:1.35rem; font-weight:800;">
        <span>Total Payable</span>
        <span style="color:#059669;">₹<%= totalAmount.toFixed(2) %></span>
      </div>

      <div style="margin-top:24px;">
        <a href="/cart" class="mm-btn mm-btn-secondary" style="width:100%; text-align:center;">
          <i class="fa-solid fa-arrow-left"></i> Edit Cart Items
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../includes/footer.ejs') %>

<script>
  function setPaymentMethod(method) {
    document.querySelectorAll('.payment-card-option').forEach(card => {
      card.classList.toggle('active', card.dataset.method === method);
    });

    document.getElementById('paymentInput').value = method;

    const upiBox = document.getElementById('upi-details');
    const cardBox = document.getElementById('card-details');

    if (method === 'upi') {
      upiBox.style.display = 'block';
      cardBox.style.display = 'none';
    } else if (method === 'card') {
      upiBox.style.display = 'none';
      cardBox.style.display = 'block';
    } else {
      upiBox.style.display = 'none';
      cardBox.style.display = 'none';
    }
  }
</script>
