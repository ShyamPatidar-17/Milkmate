<%- include('../includes/navbar.ejs') %>
<link rel="stylesheet" href="/css/product/edit.css">

<div class="prod-form-wrapper">
  <div class="prod-form-card">
    <div class="prod-form-head">
      <span class="prod-form-badge"><i class="fa-solid fa-pen-to-square"></i> Store Product</span>
      <h2>Edit Product Details</h2>
      <p>Updating details for <%= product.name %></p>
    </div>

    <form action="/product/edit/<%= product._id %>?_method=PUT" method="POST" id="editProductForm">
      <!-- Product Name -->
      <div class="mm-form-group">
        <label class="mm-label" for="name">Product Name *</label>
        <input type="text" id="name" name="product[name]" class="mm-input" value="<%= product.name %>" required>
      </div>

      <!-- Price -->
      <div class="mm-form-group">
        <label class="mm-label" for="price">Price (₹) *</label>
        <input type="number" id="price" name="product[price]" step="0.01" class="mm-input" value="<%= product.price %>" required min="1">
      </div>

      <!-- Description -->
      <div class="mm-form-group">
        <label class="mm-label" for="desc">Product Description *</label>
        <textarea id="desc" name="product[desc]" rows="3" class="mm-textarea" required><%= product.desc %></textarea>
      </div>

      <!-- Image URL -->
      <div class="mm-form-group">
        <label class="mm-label" for="imageURL">Image URL</label>
        <input type="url" id="imageURL" name="product[image]" class="mm-input" value="<%= product.image %>">
      </div>

      <div class="prod-form-footer">
        <button type="submit" class="mm-btn mm-btn-primary mm-btn-lg" style="width:100%;">
          <i class="fa-solid fa-floppy-disk"></i> Save Product Changes
        </button>
        <a href="/product" class="mm-btn mm-btn-secondary" style="width:100%; text-align:center;">
          <i class="fa-solid fa-arrow-left"></i> Cancel & Return
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('../includes/footer.ejs') %>
